{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "UPL",
    "scopeName": "source.upl",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.upl",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.number-sign.upl",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.upl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.upl",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.upl",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "name": "entity.name.tag.upl",
                    "match": "@(snapshot|baremetal|pure|hosted|inline|aligned)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.upl",
                    "match": "\\b(if|si|else|sino|while|mientras|for|para|return|retornar)\\b"
                },
                {
                    "name": "keyword.declaration.upl",
                    "match": "\\b(fn|funcion|let|sea|mut|const|constante|struct|estructura|module|modulo|import|importar|use|usar|pub|publico|as|como)\\b"
                },
                {
                    "name": "keyword.other.asm.upl",
                    "match": "\\b(asm|ensamblador)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.upl",
                    "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|bool|str|void|comp3|UrepSecurityContext|Vector4D|CpuRegisterState|MasmOpcodeEntry)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.upl",
                    "match": "\\b(true|false|verdadero|falso)\\b"
                },
                {
                    "name": "constant.language.null.upl",
                    "match": "\\b(null|nulo)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.upl",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.float.upl",
                    "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.decimal.upl",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.upl"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.upl",
                    "match": "(\\+|\\-|\\*|/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||!|&|\\||->)"
                }
            ]
        }
    }
}
