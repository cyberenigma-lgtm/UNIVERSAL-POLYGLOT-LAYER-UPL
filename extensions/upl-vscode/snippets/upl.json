{
    "Main Function": {
        "prefix": "main",
        "body": [
            "pub fn main() -> i32 {",
            "    $0",
            "    return 0;",
            "}"
        ],
        "description": "Función principal de entrada UPL"
    },
    "Module Declaration": {
        "prefix": "mod",
        "body": [
            "module ${1:nombre_modulo};",
            "",
            "$0"
        ],
        "description": "Declaración de módulo UPL"
    },
    "Import Module": {
        "prefix": "imp",
        "body": [
            "import ${1:urep_guard};$0"
        ],
        "description": "Importar módulo del sistema"
    },
    "Public Function": {
        "prefix": "fn",
        "body": [
            "pub fn ${1:nombre}(${2:params}) -> ${3:i32} {",
            "    $0",
            "}"
        ],
        "description": "Declarar función pública"
    },
    "Struct Declaration": {
        "prefix": "struct",
        "body": [
            "@snapshot",
            "struct ${1:NombreEstructura} {",
            "    ${2:campo}: ${3:u32}",
            "}$0"
        ],
        "description": "Estructura con protección de memoria @snapshot"
    },
    "Inline Assembly": {
        "prefix": "asm",
        "body": [
            "asm {",
            "    ${1:nop}",
            "}$0"
        ],
        "description": "Bloque de ensamblador x86_64 directo"
    },
    "Network Socket": {
        "prefix": "net_tcp",
        "body": [
            "sea sock: i64 = net_socket_tcp();",
            "si sock >= 0 {",
            "    net_conectar(sock, \"${1:127.0.0.1}\", ${2:8080});",
            "    $0",
            "    net_cerrar(sock);",
            "}"
        ],
        "description": "Cliente de red TCP soberano"
    },
    "Mutex Lock": {
        "prefix": "mutex",
        "body": [
            "sea mtx: *void = mutex_crear();",
            "si mutex_bloquear(mtx) {",
            "    $0",
            "    mutex_desbloquear(mtx);",
            "}",
            "mutex_destruir(mtx);"
        ],
        "description": "Bloqueo y sincronización de hilos con Mutex"
    },
    "COMP-3 Financial": {
        "prefix": "comp3",
        "body": [
            "let mut balance: [u8; 8];",
            "upl_comp3_from_str(balance, 8, \"${1:1000.00}\", 10, 2);$0"
        ],
        "description": "Número decimal financiero exacto BCD COMP-3"
    }
}
