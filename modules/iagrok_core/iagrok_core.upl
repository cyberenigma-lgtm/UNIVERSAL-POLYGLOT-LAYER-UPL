// ============================================================================
// MODULO: IAGROK-V5 SOVEREIGN COGNITIVE CORE & ATTENTION BUS (UPL+ NATIVO)
// Proposito: Bus de estado global soberano, planificador de atencion y vector router
// Rendimiento: Determinismo puro en tiempo real (< 1 ms), cero runtime externo
// ============================================================================

modulo iagrok_core;

publico estructura IagrokTask {
    task_id: u32,
    priority: u32,
    payload_hash: u64,
    status: u32 // 0: Idle, 1: Encolada, 2: Procesada
}

publico estructura IagrokSystemState {
    active_agents: u32,
    tasks_processed: u64,
    last_latency_cycles: u64,
    cpu_load_ratio: u32,
    initialized: i32
}

sea mut g_system: IagrokSystemState;
sea mut g_queue: [IagrokTask; 32];
sea mut g_queue_count: u32;

publico funcion IagrokInit() -> i32 {
    g_system.active_agents = 60;
    g_system.tasks_processed = 0;
    g_system.last_latency_cycles = 0;
    g_system.cpu_load_ratio = 24; // 2.4%
    g_system.initialized = 1;
    g_queue_count = 0;

    sea mut i: usize = 0;
    mientras i < 32 {
        g_queue[i].task_id = 0;
        g_queue[i].priority = 0;
        g_queue[i].payload_hash = 0;
        g_queue[i].status = 0;
        i = i + 1;
    }

    retornar 0;
}

// Encolar tarea con prioridad en el scheduler de atencion
publico funcion IagrokEnqueueTask(task_id: u32, priority: u32, payload_hash: u64) -> i32 {
    si g_queue_count >= 32 {
        retornar -1; // Cola saturada
    }

    sea idx: usize = g_queue_count como usize;
    g_queue[idx].task_id = task_id;
    g_queue[idx].priority = priority;
    g_queue[idx].payload_hash = payload_hash;
    g_queue[idx].status = 1;

    g_queue_count = g_queue_count + 1;
    retornar 0;
}

// Desencolar la tarea con mayor prioridad (menor numero de prioridad)
publico funcion IagrokDispatchHighestPriority() -> u32 {
    si g_queue_count == 0 {
        retornar 0;
    }

    sea mut best_idx: usize = 0;
    sea mut best_pri: u32 = g_queue[0].priority;
    sea mut i: usize = 1;

    mientras i < (g_queue_count como usize) {
        si g_queue[i].priority < best_pri {
            best_pri = g_queue[i].priority;
            best_idx = i;
        }
        i = i + 1;
    }

    sea dispatched_id: u32 = g_queue[best_idx].task_id;
    g_queue[best_idx].status = 2; // Procesada

    // Compactar cola desplazando el ultimo elemento
    sea last_idx: usize = (g_queue_count - 1) como usize;
    si best_idx != last_idx {
        g_queue[best_idx].task_id = g_queue[last_idx].task_id;
        g_queue[best_idx].priority = g_queue[last_idx].priority;
        g_queue[best_idx].payload_hash = g_queue[last_idx].payload_hash;
        g_queue[best_idx].status = g_queue[last_idx].status;
    }

    g_queue_count = g_queue_count - 1;
    g_system.tasks_processed = g_system.tasks_processed + 1;

    retornar dispatched_id;
}

publico funcion IagrokGetTasksProcessed() -> u64 {
    retornar g_system.tasks_processed;
}

publico funcion IagrokGetQueueCount() -> u32 {
    retornar g_queue_count;
}
