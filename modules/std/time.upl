module std_time;

pub fn sleep_ms(ms: i32) -> void {
    upl_sleep_ms(ms);
}

pub fn frame_rate_delay_60fps() -> void {
    upl_sleep_ms(16);
}

pub fn frame_rate_delay_30fps() -> void {
    upl_sleep_ms(33);
}
