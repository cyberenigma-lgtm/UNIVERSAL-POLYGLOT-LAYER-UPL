modulo std_threads;

// ============================================================================
// UPL+ BIBLIOTECA ESTANDAR: MULTIHILO Y CONCURRENCIA DE SILICIO (std_threads)
// Hilos de Hardware Nativos y Exclusion Mutua (Mutex) sin Sobrecoste
// ============================================================================

incrustar "c" {
#ifdef _WIN32
  #include <windows.h>
  #include <process.h>
  typedef HANDLE upl_thread_handle_t;
  typedef CRITICAL_SECTION upl_mutex_handle_t;
#else
  #include <pthread.h>
  #include <unistd.h>
  typedef pthread_t upl_thread_handle_t;
  typedef pthread_mutex_t upl_mutex_handle_t;
#endif
#include <stdio.h>
#include <stdlib.h>
}

// 1. Estructura de Control de Mutex Soberano
pub struct UplMutex {
    pub id: u64,
    pub inicializado: bool,
    pub canario: u32
}

// 2. Crear e Inicializar Mutex
publico funcion mutex_crear() -> *void {
    sea mut ptr: *void = 0 como *void;
    incrustar "c" {
#ifdef _WIN32
        CRITICAL_SECTION *cs = (CRITICAL_SECTION*)malloc(sizeof(CRITICAL_SECTION));
        if (cs) {
            InitializeCriticalSection(cs);
            ptr = (void*)cs;
        }
#else
        pthread_mutex_t *mtx = (pthread_mutex_t*)malloc(sizeof(pthread_mutex_t));
        if (mtx) {
            pthread_mutex_init(mtx, NULL);
            ptr = (void*)mtx;
        }
#endif
    }
    retornar ptr;
}

// 3. Bloquear Mutex (Adquirir Bloqueo)
publico funcion mutex_bloquear(m: *void) -> bool {
    sea mut ok: bool = false;
    incrustar "c" {
        if (m) {
#ifdef _WIN32
            EnterCriticalSection((CRITICAL_SECTION*)m);
            ok = 1;
#else
            if (pthread_mutex_lock((pthread_mutex_t*)m) == 0) {
                ok = 1;
            }
#endif
        }
    }
    retornar ok;
}

// 4. Desbloquear Mutex (Liberar Bloqueo)
publico funcion mutex_desbloquear(m: *void) -> bool {
    sea mut ok: bool = false;
    incrustar "c" {
        if (m) {
#ifdef _WIN32
            LeaveCriticalSection((CRITICAL_SECTION*)m);
            ok = 1;
#else
            if (pthread_mutex_unlock((pthread_mutex_t*)m) == 0) {
                ok = 1;
            }
#endif
        }
    }
    retornar ok;
}

// 5. Destruir y Liberar Mutex
publico funcion mutex_destruir(m: *void) -> bool {
    sea mut ok: bool = false;
    incrustar "c" {
        if (m) {
#ifdef _WIN32
            DeleteCriticalSection((CRITICAL_SECTION*)m);
            free(m);
            ok = 1;
#else
            pthread_mutex_destroy((pthread_mutex_t*)m);
            free(m);
            ok = 1;
#endif
        }
    }
    retornar ok;
}

// 6. Suspender Hilo Actual (Dormir en Milisegundos)
publico funcion hilo_dormir(ms: u32) -> void {
    incrustar "c" {
#ifdef _WIN32
        Sleep((DWORD)ms);
#else
        usleep((useconds_t)ms * 1000);
#endif
    }
}
