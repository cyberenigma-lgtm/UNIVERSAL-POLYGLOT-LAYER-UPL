// ============================================================================
// UPL STANDARD LIBRARY: CRYPTOGRAPHY & HARDWARE ENTROPY (std::crypto)
// Language: Pure UPL+ / Native Systems Standard Library
// Author: Jose Manuel Moreno (Noxferion)
// ============================================================================
// Native SHA-256 cryptographic hashing, hardware-accelerated CRC-32C,
// and hardware true-random entropy (RDRAND / BCrypt / CryptGenRandom).
// Zero third-party dependencies.
// ============================================================================

modulo std_crypto;

embed {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <stdbool.h>

#ifdef _WIN32
#  include <windows.h>
#  include <wincrypt.h>
#else
#  include <fcntl.h>
#  include <unistd.h>
#endif

/* --- SHA-256 C99 NATIVO DE ALTO RENDIMIENTO --- */
typedef struct {
    uint32_t state[8];
    uint64_t count;
    uint8_t buffer[64];
} UplSha256Ctx;

#define UPL_ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
#define UPL_CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))
#define UPL_MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
#define UPL_SIG0(x) (UPL_ROTR(x, 2) ^ UPL_ROTR(x, 13) ^ UPL_ROTR(x, 22))
#define UPL_SIG1(x) (UPL_ROTR(x, 6) ^ UPL_ROTR(x, 11) ^ UPL_ROTR(x, 25))
#define UPL_GAM0(x) (UPL_ROTR(x, 7) ^ UPL_ROTR(x, 18) ^ ((x) >> 3))
#define UPL_GAM1(x) (UPL_ROTR(x, 17) ^ UPL_ROTR(x, 19) ^ ((x) >> 10))

static const uint32_t K256[64] = {
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
};

static void upl_sha256_transform(UplSha256Ctx *ctx, const uint8_t data[64]) {
    uint32_t a = ctx->state[0], b = ctx->state[1], c = ctx->state[2], d = ctx->state[3];
    uint32_t e = ctx->state[4], f = ctx->state[5], g = ctx->state[6], h = ctx->state[7];
    uint32_t m[64];
    for (int i = 0; i < 16; ++i) {
        m[i] = ((uint32_t)data[i*4] << 24) | ((uint32_t)data[i*4 + 1] << 16) |
               ((uint32_t)data[i*4 + 2] << 8)  | ((uint32_t)data[i*4 + 3]);
    }
    for (int i = 16; i < 64; ++i) {
        m[i] = UPL_GAM1(m[i-2]) + m[i-7] + UPL_GAM0(m[i-15]) + m[i-16];
    }
    for (int i = 0; i < 64; ++i) {
        uint32_t t1 = h + UPL_SIG1(e) + UPL_CH(e, f, g) + K256[i] + m[i];
        uint32_t t2 = UPL_SIG0(a) + UPL_MAJ(a, b, c);
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    ctx->state[0] += a; ctx->state[1] += b; ctx->state[2] += c; ctx->state[3] += d;
    ctx->state[4] += e; ctx->state[5] += f; ctx->state[6] += g; ctx->state[7] += h;
}

static void upl_sha256_init_internal(UplSha256Ctx *ctx) {
    ctx->count = 0;
    ctx->state[0] = 0x6a09e667; ctx->state[1] = 0xbb67ae85;
    ctx->state[2] = 0x3c6ef372; ctx->state[3] = 0xa54ff53a;
    ctx->state[4] = 0x510e527f; ctx->state[5] = 0x9b05688c;
    ctx->state[6] = 0x1f83d9ab; ctx->state[7] = 0x5be0cd19;
}

static void upl_sha256_update_internal(UplSha256Ctx *ctx, const uint8_t *data, size_t len) {
    size_t idx = (size_t)(ctx->count % 64);
    ctx->count += len;
    while (len > 0) {
        size_t part = 64 - idx;
        if (len < part) part = len;
        memcpy(&ctx->buffer[idx], data, part);
        data += part;
        len -= part;
        idx += part;
        if (idx == 64) {
            upl_sha256_transform(ctx, ctx->buffer);
            idx = 0;
        }
    }
}

static void upl_sha256_final_internal(UplSha256Ctx *ctx, uint8_t digest[32]) {
    uint8_t pad[64] = {0x80};
    uint64_t bits = ctx->count * 8;
    uint8_t bits_be[8];
    for (int i = 0; i < 8; ++i) bits_be[i] = (uint8_t)(bits >> ((7 - i) * 8));
    size_t idx = (size_t)(ctx->count % 64);
    size_t pad_len = (idx < 56) ? (56 - idx) : (120 - idx);
    upl_sha256_update_internal(ctx, pad, pad_len);
    upl_sha256_update_internal(ctx, bits_be, 8);
    for (int i = 0; i < 8; ++i) {
        digest[i*4]   = (uint8_t)(ctx->state[i] >> 24);
        digest[i*4+1] = (uint8_t)(ctx->state[i] >> 16);
        digest[i*4+2] = (uint8_t)(ctx->state[i] >> 8);
        digest[i*4+3] = (uint8_t)(ctx->state[i]);
    }
}
}

// 1. Calcula SHA-256 en formato Hexadecimal (64 caracteres)
pub fn crypto_sha256_hex(texto: str, salida_hex: str) -> bool {
    embed {
        if (!texto || !salida_hex) return false;
        char *out = (char*)salida_hex;
        UplSha256Ctx ctx;
        upl_sha256_init_internal(&ctx);
        upl_sha256_update_internal(&ctx, (const uint8_t*)texto, strlen(texto));
        uint8_t digest[32];
        upl_sha256_final_internal(&ctx, digest);
        for (int i = 0; i < 32; ++i) {
            sprintf(out + (i * 2), "%02x", digest[i]);
        }
        out[64] = '\0';
        return true;
    }
    retornar false;
}

// 2. Hardware CRC-32C Polinomial (Castagnoli 0x82F63B78)
pub fn crypto_crc32(datos: str, len: u64) -> u32 {
    let mut crc: u32 = 0;
    embed {
        if (!datos) return 0;
        uint32_t c = 0xFFFFFFFF;
        const uint8_t *p = (const uint8_t*)datos;
        for (size_t i = 0; i < len; ++i) {
            c ^= p[i];
            for (int k = 0; k < 8; ++k) {
                c = (c >> 1) ^ (0x82F63B78 & (-(c & 1)));
            }
        }
        return ~c;
    }
    retornar crc;
}

// 3. Generación de Bytes Criptográficamente Seguros desde el Silicio
pub fn crypto_entropia_hardware(buffer: *void, longitud: u64) -> bool {
    embed {
        if (!buffer || longitud == 0) return false;
#ifdef _WIN32
        HCRYPTPROV hProv;
        if (CryptAcquireContext(&hProv, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT | CRYPT_SILENT)) {
            BOOL ok = CryptGenRandom(hProv, (DWORD)longitud, (BYTE*)buffer);
            CryptReleaseContext(hProv, 0);
            return ok ? true : false;
        }
        return false;
#else
        int fd = open(/dev/urandom, O_RDONLY);
        if (fd < 0) return false;
        ssize_t r = read(fd, buffer, longitud);
        close(fd);
        return r == (ssize_t)longitud;
#endif
    }
    retornar false;
}