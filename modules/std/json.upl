modulo std_json;

// ============================================================================
// UPL+ BIBLIOTECA ESTANDAR: MODULO DE SERIALIZACION JSON SOBERANO (std_json)
// Parseo y Generacion JSON Determinista en Silicio (ANSI C99 Zero-Alloc)
// ============================================================================

incrustar "c" {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Parser JSON ultra-rapido sin dependencias externas
static char* upl_json_find_key(const char *json, const char *key) {
    if (!json || !key) return NULL;
    char search[128];
    snprintf(search, sizeof(search), "\"%s\"", key);
    char *pos = strstr(json, search);
    if (!pos) return NULL;
    pos = strchr(pos + strlen(search), ':');
    if (!pos) return NULL;
    pos++;
    while (*pos == ' ' || *pos == '\t' || *pos == '\r' || *pos == '\n') pos++;
    return pos;
}
}

// 1. Obtener Valor de Cadena desde JSON
publico funcion json_obtener_cadena(json_texto: str, clave: str, buffer_salida: str, max_long: i32) -> bool {
    sea mut encontrado: bool = false;
    incrustar "c" {
        char *val = upl_json_find_key(json_texto, clave);
        if (val && *val == '"') {
            val++;
            char *end = strchr(val, '"');
            if (end) {
                int len = (int)(end - val);
                if (len >= max_long) len = max_long - 1;
                strncpy(buffer_salida, val, len);
                buffer_salida[len] = '\0';
                encontrado = 1;
            }
        }
    }
    retornar encontrado;
}

// 2. Obtener Valor Entero desde JSON
publico funcion json_obtener_entero(json_texto: str, clave: str) -> i64 {
    sea mut numero: i64 = 0;
    incrustar "c" {
        char *val = upl_json_find_key(json_texto, clave);
        if (val) {
            numero = (int64_t)strtoll(val, NULL, 10);
        }
    }
    retornar numero;
}

// 3. Obtener Valor Booleano desde JSON
publico funcion json_obtener_booleano(json_texto: str, clave: str) -> bool {
    sea mut b: bool = false;
    incrustar "c" {
        char *val = upl_json_find_key(json_texto, clave);
        if (val) {
            if (strncmp(val, "true", 4) == 0) b = 1;
            else if (strncmp(val, "false", 5) == 0) b = 0;
        }
    }
    retornar b;
}
