modulo std_net;

// ============================================================================
// UPL+ BIBLIOTECA ESTANDAR: MODULO DE REDES SOBERANAS (std_net)
// Sockets TCP/IP y UDP de Alto Rendimiento para Sistemas Freestanding
// ============================================================================

incrustar "c" {
#ifdef _WIN32
  #include <winsock2.h>
  #include <ws2tcpip.h>
  #pragma comment(lib, "ws2_32.lib")
#else
  #include <sys/types.h>
  #include <sys/socket.h>
  #include <netinet/in.h>
  #include <arpa/inet.h>
  #include <unistd.h>
  #define SOCKET int
  #define INVALID_SOCKET -1
  #define SOCKET_ERROR -1
  #define closesocket close
#endif
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static int g_upl_net_initialized = 0;

static inline void upl_net_ensure_init(void) {
#ifdef _WIN32
    if (!g_upl_net_initialized) {
        WSADATA wsa;
        if (WSAStartup(MAKEWORD(2, 2), &wsa) == 0) {
            g_upl_net_initialized = 1;
        }
    }
#else
    g_upl_net_initialized = 1;
#endif
}
}

// 1. Inicializar Subsistema de Red
publico funcion net_iniciar() -> bool {
    sea mut ok: bool = false;
    incrustar "c" {
        upl_net_ensure_init();
        ok = (g_upl_net_initialized != 0);
    }
    retornar ok;
}

// 2. Crear Socket TCP
publico funcion net_socket_tcp() -> i64 {
    sea mut sock_fd: i64 = -1;
    incrustar "c" {
        upl_net_ensure_init();
        SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        if (s != INVALID_SOCKET) {
            sock_fd = (int64_t)s;
        }
    }
    retornar sock_fd;
}

// 3. Conectar Socket a Servidor Remoto
publico funcion net_conectar(sock: i64, ip: str, puerto: i32) -> bool {
    sea mut exito: bool = false;
    incrustar "c" {
        if (sock >= 0 && ip) {
            struct sockaddr_in addr;
            memset(&addr, 0, sizeof(addr));
            addr.sin_family = AF_INET;
            addr.sin_port = htons((uint16_t)puerto);
            addr.sin_addr.s_addr = inet_addr(ip);

            if (connect((SOCKET)sock, (struct sockaddr*)&addr, sizeof(addr)) != SOCKET_ERROR) {
                exito = 1;
            }
        }
    }
    retornar exito;
}

// 4. Poner Socket en Modo Escucha (Servidor)
publico funcion net_escuchar(sock: i64, puerto: i32, backlog: i32) -> bool {
    sea mut exito: bool = false;
    incrustar "c" {
        if (sock >= 0) {
            struct sockaddr_in addr;
            memset(&addr, 0, sizeof(addr));
            addr.sin_family = AF_INET;
            addr.sin_port = htons((uint16_t)puerto);
            addr.sin_addr.s_addr = INADDR_ANY;

            int opt = 1;
            setsockopt((SOCKET)sock, SOL_SOCKET, SO_REUSEADDR, (const char*)&opt, sizeof(opt));

            if (bind((SOCKET)sock, (struct sockaddr*)&addr, sizeof(addr)) != SOCKET_ERROR) {
                if (listen((SOCKET)sock, backlog) != SOCKET_ERROR) {
                    exito = 1;
                }
            }
        }
    }
    retornar exito;
}

// 5. Aceptar Conexion Entrante
publico funcion net_aceptar(sock_servidor: i64) -> i64 {
    sea mut cliente_sock: i64 = -1;
    incrustar "c" {
        if (sock_servidor >= 0) {
            struct sockaddr_in client_addr;
            int addr_len = sizeof(client_addr);
            SOCKET c = accept((SOCKET)sock_servidor, (struct sockaddr*)&client_addr, &addr_len);
            if (c != INVALID_SOCKET) {
                cliente_sock = (int64_t)c;
            }
        }
    }
    retornar cliente_sock;
}

// 6. Enviar Datos
publico funcion net_enviar(sock: i64, datos: str, bytes: i32) -> i32 {
    sea mut enviados: i32 = -1;
    incrustar "c" {
        if (sock >= 0 && datos) {
            enviados = send((SOCKET)sock, datos, bytes, 0);
        }
    }
    retornar enviados;
}

// 7. Recibir Datos
publico funcion net_recibir(sock: i64, buffer: *void, max_bytes: i32) -> i32 {
    sea mut recibidos: i32 = -1;
    incrustar "c" {
        if (sock >= 0 && buffer) {
            recibidos = recv((SOCKET)sock, (char*)buffer, max_bytes, 0);
        }
    }
    retornar recibidos;
}

// 8. Cerrar Socket
publico funcion net_cerrar(sock: i64) -> bool {
    sea mut ok: bool = false;
    incrustar "c" {
        if (sock >= 0) {
            closesocket((SOCKET)sock);
            ok = 1;
        }
    }
    retornar ok;
}
