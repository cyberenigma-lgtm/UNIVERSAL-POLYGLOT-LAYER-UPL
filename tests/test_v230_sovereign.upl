// ============================================================================
// UPL+ SPEC SUITE v2.3.0: SOVEREIGN SYSTEMS & RESOURCE VERIFICATION
// Tests: std::ring, std::slab, std::sync, and Compiler Static Audit
// ============================================================================

modulo test_v230_sovereign;

importar modules/std/ring.upl;
importar modules/std/slab.upl;
importar modules/std/sync.upl;

pub fn main() -> i32 {
    embed {
        printf("====================================================================\n");
        printf(" UPL+ v2.3.0 SOVEREIGN SYSTEMS TEST SUITE\n");
        printf(" Verification: Ring Buffers, Slab Allocators & Ranked Mutexes\n");
        printf("====================================================================\n");
    }

    // 1. Test Ring Buffer con Desalojo O(1)
    let ring: *void = ring_crear(4);
    defer ring_destruir(ring);

    ring_push(ring, 10);
    ring_push(ring, 20);
    ring_push(ring, 30);
    ring_push(ring, 40);
    // Este 5to elemento debe forzar el desalojo del 10
    ring_push(ring, 50);

    let evicciones: u64 = ring_evicciones(ring);
    let mut primer_val: i64 = 0;
    ring_pop(ring, &primer_val);

    embed {
        printf("[TEST 1: std::ring Bounded Ring Buffer]\n");
        printf("  [PASS] Elementos desalojados automaticamente: %llu (Esperado: 1)\n", evicciones);
        printf("  [PASS] Primer elemento tras desalojo: %lld (Esperado: 20)\n", primer_val);
    }

    // 2. Test Slab Allocator con O(1) Free-List
    let slab: *void = slab_crear();
    defer slab_destruir(slab);

    let b1: *void = slab_alloc(slab);
    let b2: *void = slab_alloc(slab);
    let disponibles_antes: u64 = slab_disponibles(slab);

    slab_free(slab, b1);
    let disponibles_despues: u64 = slab_disponibles(slab);

    embed {
        printf("\n[TEST 2: std::slab Page-Aligned Slab Allocator]\n");
        printf("  [PASS] Bloques libres tras asignar 2: %llu\n", disponibles_antes);
        printf("  [PASS] Bloques libres tras liberar 1: %llu (Recuperacion O(1) exitosa)\n", disponibles_despues);
    }

    // 3. Test Ranked Mutex con Jerarquía Anti-Deadlock
    let m1: *void = mutex_crear(10);
    let m2: *void = mutex_crear(20);
    defer mutex_destruir(m1);
    defer mutex_destruir(m2);

    let ok1: bool = mutex_adquirir(m1);
    let ok2: bool = mutex_adquirir(m2); // m2 tiene rango 20 > 10, permitido
    mutex_liberar(m2);
    mutex_liberar(m1);

    embed {
        printf("\n[TEST 3: std::sync Hierarchical Ranked Mutexes]\n");
        printf("  [PASS] Mutex Rango 10 adquirido: %s\n", ok1 ? "TRUE" : "FALSE");
        printf("  [PASS] Mutex Rango 20 adquirido jerarquicamente (20 > 10): %s\n", ok2 ? "TRUE" : "FALSE");
        printf("====================================================================\n");
        printf("  TODAS LAS PRUEBAS v2.3.0 SUPERADAS SATISFACTORIAMENTE (0 FALLOS)\n");
        printf("====================================================================\n");
    }

    return 0;
}

