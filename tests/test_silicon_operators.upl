modulo test_silicon_ops;

pub fn test_operadores_silicio() -> i32 {
    // 1. Modulo (%)
    let a: i32 = 100 % 7; // 100 = 14*7 + 2 => 2
    si a != 2 { retornar 101; }

    // 2. Desplazamiento de bits (<< y >>)
    let b: u32 = 1 << 8; // 256
    si b != 256 { retornar 102; }

    let c: u32 = b >> 3; // 256 >> 3 = 32
    si c != 32 { retornar 103; }

    // 3. Bitwise NOT (~)
    let d: u8 = 0;
    let not_d: u8 = ~d; // 0xFF = 255
    si not_d != 255 { retornar 104; }

    // 4. Asignaciones compuestas (+=, -=, *=, /=, %=)
    let mut x: i32 = 10;
    x += 5; // 15
    si x != 15 { retornar 105; }

    x -= 3; // 12
    si x != 12 { retornar 106; }

    x *= 4; // 48
    si x != 48 { retornar 107; }

    x /= 6; // 8
    si x != 8 { retornar 108; }

    x %= 5; // 3
    si x != 3 { retornar 109; }

    // 5. Asignaciones compuestas de bits (<<=, >>=, &=, |=, ^=)
    let mut bits: u32 = 1;
    bits <<= 4; // 16
    si bits != 16 { retornar 110; }

    bits >>= 2; // 4
    si bits != 4 { retornar 111; }

    bits |= 2; // 4 | 2 = 6
    si bits != 6 { retornar 112; }

    bits &= 3; // 6 & 3 = 2
    si bits != 2 { retornar 113; }

    bits ^= 1; // 2 ^ 1 = 3
    si bits != 3 { retornar 114; }

    // 6. Puntero y direccion de memoria (&var)
    let val: i32 = 42;
    let pval: *i32 = &val;
    si *pval != 42 { retornar 115; }

    retornar 0; // Exito total
}

pub fn main() -> i32 {
    let res: i32 = test_operadores_silicio();
    si res == 0 {
        retornar 0;
    }
    retornar res;
}
