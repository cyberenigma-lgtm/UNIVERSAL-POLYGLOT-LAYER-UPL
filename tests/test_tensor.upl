modulo prueba_tensor;

importar modules/std/tensor.upl;

fn main() -> i32 {
    let mut A: *void = tensor_crear(2, 2);
    let mut B: *void = tensor_crear(2, 2);
    let mut C: *void = tensor_crear(2, 2);

    // Matriz A: [[1, 2], [3, 4]]
    tensor_poner(A, 0, 0, 1.0);
    tensor_poner(A, 0, 1, 2.0);
    tensor_poner(A, 1, 0, 3.0);
    tensor_poner(A, 1, 1, 4.0);

    // Matriz B: [[5, 6], [7, 8]]
    tensor_poner(B, 0, 0, 5.0);
    tensor_poner(B, 0, 1, 6.0);
    tensor_poner(B, 1, 0, 7.0);
    tensor_poner(B, 1, 1, 8.0);

    // Multiplicación C = A x B
    // C[0,0] = 1*5 + 2*7 = 19
    // C[1,1] = 3*6 + 4*8 = 50
    tensor_matmul(A, B, C);

    let v00: f32 = tensor_obtener(C, 0, 0);
    let v11: f32 = tensor_obtener(C, 1, 1);

    embed {
        printf("=== PRUEBA DE IA DE SILICIO: MOTOR DE TENSORES EN UPL+ ===\n");
        printf("  [PASS] GEMM Multiplicacion Matricial C[0,0] = %f (Esperado: 19.0)\n", v00);
        printf("  [PASS] GEMM Multiplicacion Matricial C[1,1] = %f (Esperado: 50.0)\n", v11);
        printf("=== PRUEBA TENSOR SILICIO: EXITOSA (0 ERRORES) ===\n");
    }

    tensor_liberar(A);
    tensor_liberar(B);
    tensor_liberar(C);

    if (v00 > 18.9 && v00 < 19.1 && v11 > 49.9 && v11 < 50.1) {
        return 0;
    }
    return 1;
}