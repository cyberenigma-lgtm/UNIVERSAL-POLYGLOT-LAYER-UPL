// ============================================================================
// TEST: IMPORTACIÓN MODULAR Y SISTEMA MULTI-MÓDULO UPL
// ============================================================================

module test_modular;

import urep_guard;
import vector_ops;

pub fn main() -> i32 {
    // 1. Inicializar contexto de seguridad UREP importado de modules/urep/urep_guard.upl
    let mut ctx: UrepSecurityContext;
    urep_guard_init(&ctx, 0x00400000, 0x004FFFFF, 0xCAFEBABE12345678);

    // 2. Comprobar puntero seguro dentro de límites de código
    let rip_test: u64 = 0x00401050;
    let rip_valido: bool = urep_verify_instruction_pointer(&ctx, rip_test);

    // 3. Crear vectores 4D importados de modules/compute/vector_ops.upl
    let mut v1: Vector4D;
    vec4_init(&v1, 2, 3, 4, 5);

    let mut v2: Vector4D;
    vec4_init(&v2, 1, 1, 1, 1);

    // 4. Calcular producto escalar usando función del módulo importado
    let dot: u64 = vec4_dot_product(&v1, &v2);

    // 5. Imprimir informe de verificación modular
    printf("====================================================================\n");
    printf("   TEST DE INTEGRACION MODULAR UPL: UREP + VECTOR COMPUTE\n");
    printf("====================================================================\n");
    printf("[UREP] Segmento de codigo verificado: 0x%llX - 0x%llX\n", ctx.text_segment_base, ctx.text_segment_limit);
    printf("[UREP] Puntero RIP analizado: 0x%llX -> Valido: %d\n", rip_test, rip_valido);
    printf("[UREP] Canario de proteccion activo: 0x%llX\n", ctx.guard_canary);
    printf("--------------------------------------------------------------------\n");
    printf("[VECTOR] Vector 1 (v1): (%llu, %llu, %llu, %llu)\n", v1.x, v1.y, v1.z, v1.w);
    printf("[VECTOR] Vector 2 (v2): (%llu, %llu, %llu, %llu)\n", v2.x, v2.y, v2.z, v2.w);
    printf("[VECTOR] Producto Escalar 4D: %llu (Esperado: 14)\n", dot);
    printf("====================================================================\n");
    printf("  TEST MODULAR COMPLETADO CON EXITO (0 FALLOS DE MEMORIA)\n\n");

    if dot == 14 {
        return 0;
    }
    return 1;
}
