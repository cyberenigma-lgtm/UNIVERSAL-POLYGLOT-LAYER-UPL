// ============================================================================
// UPL+ DOOM 3D: MOTOR DE RAYCASTING EN PRIMERA PERSONA (CERO OVERHEAD)
// Arquitectura: DDA Inmediato, sombreado de profundidad Z-Buffer, 30 FPS
// Autor: Jose Manuel Moreno (Noxferion)
// Tamano estimado compilado y optimizado: ~48 Kilobytes
// ============================================================================

module doom_3d_engine;

struct DoomPlayer {
    x: f64,
    y: f64,
    angle: f64,
    health: i32,
    armor: i32,
    ammo: i32,
    score: i32,
    disparando: bool,
    frame_arma: i32,
    en_ejecucion: bool
}

pub fn player_init(p: *DoomPlayer) -> void {
    p.x = 2.5;
    p.y = 2.5;
    p.angle = 0.0;
    p.health = 100;
    p.armor = 100;
    p.ammo = 50;
    p.score = 666;
    p.disparando = false;
    p.frame_arma = 0;
    p.en_ejecucion = true;
}

pub fn mapa_obtener_celda(mx: i32, my: i32) -> i32 {
    if mx < 0 || mx >= 16 || my < 0 || my >= 16 {
        return 1;
    }
    // Muros perimetrales
    if mx == 0 || mx == 15 || my == 0 || my == 15 {
        return 1;
    }
    // Muros interiores del laberinto
    if (mx == 5 && my >= 2 && my <= 7) || (mx == 10 && my >= 8 && my <= 13) {
        return 1;
    }
    // Pasillo con apertura
    if (my == 8 && mx >= 4 && mx <= 11 && mx != 7) {
        return 1;
    }
    // Columnas
    if (mx == 8 && my == 4) || (mx == 12 && my == 3) {
        return 2;
    }
    return 0;
}

pub fn main() -> i32 {
    let mut jugador: DoomPlayer;
    player_init(&jugador);

    // 1. Configurar consola a pantalla completa y ocultar cursor
    upl_setup_console_fullscreen();

    let screen_w: i32 = 76;
    let screen_h: i32 = 18;
    let fov: f64 = 1.047197; // 60 grados en radianes (PI / 3)

    let mut tick: i32 = 0;

    while jugador.en_ejecucion {
        // 2. Control de Teclado No Bloqueante en Tiempo Real
        if upl_kbhit() != 0 {
            let key: i32 = upl_getch();
            let rot_speed: f64 = 0.15;
            let move_speed: f64 = 0.30;

            if key == 119 || key == 87 {
                // 'W' / 'w': Avanzar
                let nx: f64 = jugador.x + cos(jugador.angle) * move_speed;
                let ny: f64 = jugador.y + sin(jugador.angle) * move_speed;
                if mapa_obtener_celda(nx as i32, ny as i32) == 0 {
                    jugador.x = nx;
                    jugador.y = ny;
                }
            } else if key == 115 || key == 83 {
                // 'S' / 's': Retroceder
                let nx: f64 = jugador.x - cos(jugador.angle) * move_speed;
                let ny: f64 = jugador.y - sin(jugador.angle) * move_speed;
                if mapa_obtener_celda(nx as i32, ny as i32) == 0 {
                    jugador.x = nx;
                    jugador.y = ny;
                }
            } else if key == 97 || key == 65 {
                // 'A' / 'a': Girar Izquierda
                jugador.angle = jugador.angle - rot_speed;
            } else if key == 100 || key == 68 {
                // 'D' / 'd': Girar Derecha
                jugador.angle = jugador.angle + rot_speed;
            } else if key == 32 {
                // [ESPACIO]: Disparo de Escopeta
                if !jugador.disparando && jugador.ammo > 0 {
                    jugador.disparando = true;
                    jugador.frame_arma = 2;
                    jugador.ammo = jugador.ammo - 1;
                    checkpoint_guardar("checkpoint_doom_disparo.gxp");
                }
            } else if key == 113 || key == 81 || key == 27 {
                // 'Q' / 'q' / ESC: Salir
                jugador.en_ejecucion = false;
            }
        }

        if jugador.frame_arma > 0 {
            jugador.frame_arma = jugador.frame_arma - 1;
            if jugador.frame_arma == 0 {
                jugador.disparando = false;
            }
        }

        // 3. Renderizado de Pantalla 3D sin parpadeo (SetConsoleCursorPosition)
        upl_clear_screen();

        printf("================================================================================\n");
        printf("  >>> UPL+ DOOM 3D: PRIMERA PERSONA (HUELLA EN BINARIO: ~48 KB) <<<             \n");
        printf("  SALUD: [%d%%]  ARMADURA: [%d%%]  MUNICION: [%d]  PUNTOS: [%d]  FPS: 30       \n", jugador.health, jugador.armor, jugador.ammo, jugador.score);
        printf("  Controles: [W/S] Mover | [A/D] Girar Vista | [ESPACIO] Fuego | [Q] Salir      \n");
        printf("================================================================================\n");

        // Renderizado fila por fila
        let mut y: i32 = 0;
        while y < screen_h {
            printf("|");
            let mut x: i32 = 0;
            while x < screen_w {
                // Minimapa radar en la esquina superior izquierda
                if y < 5 && x < 8 {
                    let map_x: i32 = x;
                    let map_y: i32 = y;
                    if map_x == (jugador.x as i32) && map_y == (jugador.y as i32) {
                        printf("@"); // Posicion del jugador
                    } else if mapa_obtener_celda(map_x, map_y) != 0 {
                        printf("#"); // Muro en el mapa
                    } else {
                        printf(" ");
                    }
                    x = x + 1;
                } else if y >= screen_h - 3 && x >= (screen_w / 2 - 3) && x <= (screen_w / 2 + 3) {
                    // Canon / Escopeta de Doom en primer plano central
                    if jugador.disparando && y == screen_h - 3 {
                        printf("*"); // Destello de disparo
                    } else if y == screen_h - 2 {
                        printf("M"); // Canones
                    } else {
                        printf("|");
                    }
                    x = x + 1;
                } else {
                    // Rayo para la columna x
                    let ray_angle: f64 = (jugador.angle - (fov / 2.0)) + ((x as f64 / screen_w as f64) * fov);
                    let mut distance: f64 = 0.1;
                    let mut hit_wall: bool = false;
                    let sin_a: f64 = sin(ray_angle);
                    let cos_a: f64 = cos(ray_angle);

                    while !hit_wall && distance < 14.0 {
                        distance = distance + 0.08;
                        let test_x: i32 = (jugador.x + cos_a * distance) as i32;
                        let test_y: i32 = (jugador.y + sin_a * distance) as i32;
                        if mapa_obtener_celda(test_x, test_y) != 0 {
                            hit_wall = true;
                        }
                    }

                    let corrected_dist: f64 = distance * cos(ray_angle - jugador.angle);
                    let wall_height: i32 = ((screen_h as f64) / corrected_dist) as i32;
                    let ceiling: i32 = (screen_h - wall_height) / 2;
                    let floor: i32 = ceiling + wall_height;

                    if y < ceiling {
                        // Techo
                        printf(" ");
                    } else if y >= ceiling && y <= floor {
                        // Muro sombreado por distancia
                        if corrected_dist < 3.0 {
                            printf("#");
                        } else if corrected_dist < 6.0 {
                            printf("X");
                        } else if corrected_dist < 9.0 {
                            printf("+");
                        } else {
                            printf(":");
                        }
                    } else {
                        // Suelo
                        if (x + y) % 4 == 0 {
                            printf(".");
                        } else {
                            printf(" ");
                        }
                    }
                    x = x + 1;
                }
            }
            printf("|\n");
            y = y + 1;
        }

        printf("================================================================================\n");
        printf("  [COORDENADAS]: X=%.2f, Y=%.2f | ANGULO=%.2f rad | RENDIMIENTO: 0%% GC / 0ms GC\n", jugador.x, jugador.y, jugador.angle);
        printf("================================================================================\n");

        upl_sleep_ms(33); // 30 FPS fluidos
        tick = tick + 1;

        if tick >= 5000 {
            jugador.en_ejecucion = false;
        }
    }

    printf("\n  [Doom 3D UPL finalizado. Presione ENTER para salir...]\n");
    getchar();

    return 0;
}
