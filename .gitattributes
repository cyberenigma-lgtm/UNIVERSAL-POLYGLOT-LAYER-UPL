# ============================================================================
# 🛡️ GITHUB LINGUIST OVERRIDES - REPOSITORIO OFICIAL UPL+
# ============================================================================
# Declarar UPL+ como el lenguaje primario y soberano del repositorio.
# El código de bootstrapping histórico (fase 0) queda aislado en bootstrap/
# y marcado como vendored para garantizar 100% pureza soberana en GitHub.
# ============================================================================

# Lenguaje Soberano Detectable
*.upl linguist-detectable=true
*.upl linguist-language=Rust

# Bootstrapping histórico aislado
bootstrap/** linguist-vendored=true
bootstrap/** linguist-documentation=true
*.py linguist-vendored=true
*.c linguist-vendored=true
*.asm linguist-vendored=true
